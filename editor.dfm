      '// '#1585#1587#1575#1574#1604' '#1608#1589#1606#1575#1583#1610#1602' '#1581#1608#1575#1585
      'ShowMessage(const Msg: string);'
      
        'MessageDlg(const Msg: string; DlgType: TMsgDlgType; Buttons: TMs' +
        'gDlgButtons; HelpCtx: Longint): Integer;'
      'InputBox(const ACaption, APrompt, ADefault: string): string;'
      
        'InputQuery(const ACaption, APrompt: string; var Value: string): ' +
        'Boolean;'
      ''
      '// '#1578#1581#1608#1610#1604' '#1575#1604#1606#1589#1608#1589' '#1608#1575#1604#1571#1585#1602#1575#1605
      'StrToInt(const S: string): Integer;'
      'IntToStr(Value: Integer): string;'
      'StrToFloat(const S: string): Double;'
      'FloatToStr(Value: Double): string;'
      'StrToBool(const S: string): Boolean;'
      'BoolToStr(B: Boolean; UseBoolStrs: Boolean): string;'
      ''
      '// '#1575#1604#1578#1593#1575#1605#1604' '#1605#1593' '#1575#1604#1608#1602#1578' '#1608#1575#1604#1578#1575#1585#1610#1582
      'Now: TDateTime;'
      'Date: TDateTime;'
      'Time: TDateTime;'
      
        'FormatDateTime(const Format: string; DateTime: TDateTime): strin' +
        'g;'
      'EncodeDate(Year, Month, Day: Word): TDateTime;'
      'DecodeDate(Date: TDateTime; var Year, Month, Day: Word);'
      'EncodeTime(Hour, Min, Sec, MSec: Word): TDateTime;'
      'DecodeTime(Time: TDateTime; var Hour, Min, Sec, MSec: Word);'
      ''
      '// '#1575#1604#1578#1593#1575#1605#1604' '#1605#1593' '#1575#1604#1605#1604#1601#1575#1578
      'FileExists(const FileName: string): Boolean;'
      'DeleteFile(const FileName: string): Boolean;'
      'RenameFile(const OldName, NewName: string): Boolean;'
      
        'CopyFile(const ExistingFileName, NewFileName: string; FailIfExis' +
        'ts: Boolean): Boolean;'
      ''
      '// '#1575#1604#1578#1593#1575#1605#1604' '#1605#1593' '#1575#1604#1587#1604#1575#1587#1604' '#1575#1604#1606#1589#1610#1577
      'Length(const S: string): Integer;'
      'Pos(const SubStr, S: string): Integer;'
      'Copy(const S: string; Index, Count: Integer): string;'
      'Insert(const Source: string; var S: string; Index: Integer);'
      'Delete(var S: string; Index, Count: Integer);'
      'Trim(const S: string): string;'
      'UpperCase(const S: string): string;'
      'LowerCase(const S: string): string;'
      ''
      '// '#1571#1606#1608#1575#1593' '#1585#1610#1575#1590#1610#1577
      'Sqr(X: Extended): Extended;'
      'Sqrt(X: Extended): Extended;'
      'Abs(X: Extended): Extended;'
      'Round(X: Extended): Integer;'
      'Trunc(X: Extended): Integer;'
      'Random: Extended;'
      'RandomRange(const AFrom, ATo: Integer): Integer;'
      'Inc(var X: Integer; N: Integer = 1);'
      'Dec(var X: Integer; N: Integer = 1);'
      ''
      '// '#1605#1606#1591#1602#1610#1577' '#1608#1588#1585#1591#1610#1577
      
        'IfThen(AValue: Boolean; const ATrue: string; const AFalse: strin' +
        'g = '#39#39'): string;'
      ''
      '// '#1575#1604#1578#1593#1575#1605#1604' '#1605#1593' '#1575#1604#1584#1575#1603#1585#1577
      'FillChar(var X; Count: NativeInt; Value: Byte);'
      'Move(const Source; var Dest; Count: NativeInt);'
      ''
      '// '#1593#1605#1604#1610#1575#1578' '#1575#1604#1606#1592#1575#1605
      'GetCurrentDir: string;'
      'SetCurrentDir(const Dir: string): Boolean;'
      'GetEnvironmentVariable(const Name: string): string;'
      'Sleep(Milliseconds: Cardinal);'
      'Beep;'
      'Halt;')
    HexIdentifier = '$'
