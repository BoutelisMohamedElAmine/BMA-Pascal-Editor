      'function QuotedStr(const S: string): string;'
      'function AnsiQuotedStr(const S: string; Quote: Char): string;'
      'function AnsiDequotedStr(const S: string; Quote: Char): string;'
      ''
      ''
      '// System'
      'function SizeOf(Type): Integer;'
      'function TypeInfo(Type): Pointer;'
      'function Default(Type): Type;'
      ''
      '// Variants'
      'function VarType(const V: Variant): TVarType;'
      'function VarIsEmpty(const V: Variant): Boolean;'
      'function VarIsNull(const V: Variant): Boolean;'
      'function VarToStr(const V: Variant): string;'
      
        'function VarToStrDef(const V: Variant; const ADefault: string): ' +
        'string;'
      'function VarFromDateTime(DateTime: TDateTime): Variant;'
      'function VarToDateTime(const V: Variant): TDateTime;'
      ''
      '// System'
      'function ClassName(AClass: TClass): string;'
      'function ClassParent(AClass: TClass): TClass;'
      'function InheritsFrom(AClass: TClass): Boolean;'
      'function ClassInfo(AClass: TClass): Pointer;'
      ''
      '// SysUtils'
      'function CreateGUID(out Guid: TGUID): Integer;'
