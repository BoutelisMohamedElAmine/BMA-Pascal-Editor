    Lines.Strings = (
      '// Math'
      'function Abs(X); '
      'function Sqrt(X: Extended): Extended; '
      'function Power(Base, Exponent: Extended): Extended; '
      'function Sin(X: Extended): Extended; '
      'function Cos(X: Extended): Extended; '
      'function Tan(X: Extended): Extended; '
      'function ArcSin(X: Extended): Extended; '
      'function ArcCos(X: Extended): Extended; '
      'function ArcTan(X: Extended): Extended; '
      'function Ln(X: Extended): Extended; '
      'function Log10(X: Extended): Extended;'
      'function Exp(X: Extended): Extended; '
      'function Round(X: Extended): Int64; '
      'function Trunc(X: Extended): Int64; '
      'function Frac(X: Extended): Extended; '
      'function Int(X: Extended): Extended; '
      'function Random: Extended; '
      'function Random(Range: Integer): Integer;'
      'function Max(A, B: Integer): Integer;'
      'function Min(A, B: Integer): Integer;'
      'function Pi: Extended;      '
      ''
      '// SysUtils'
      'function UpperCase(const S: string): string;'
      'function LowerCase(const S: string): string;'
      'function Trim(const S: string): string;'
      'function TrimLeft(const S: string): string;'
      'function TrimRight(const S: string): string;'
      'function Pos(const Substr, S: string): Integer;'
      'function Copy(const S: string; Index, Count: Integer): string;'
      'function Delete(var S: string; Index, Count: Integer);'
      
        'function Insert(const Source: string; var S: string; Index: Inte' +
        'ger);'
      'function Length(const S: string): Integer;'
      'function Concat(s1 [, s2, ..., sn]: string): string;'
      
        'function Format(const Fmt: string; const Args: array of const): ' +
        'string;'
      'function IntToStr(Value: Integer): string;'
      'function StrToInt(const S: string): Integer;'
      
        'function StrToIntDef(const S: string; Default: Integer): Integer' +
        ';'
      'function FloatToStr(Value: Extended): string;'
      'function StrToFloat(const S: string): Extended;'
      
        'function BoolToStr(B: Boolean; UseBoolStrs: Boolean = False): st' +
        'ring;'
      ''
      '// StrUtils'
      
        'function AnsiReplaceStr(const S, OldPattern, NewPattern: string)' +
        ': string;'
      
        'function AnsiReplaceText(const S, OldPattern, NewPattern: string' +
        '): string;'
      'function ContainsStr(const AText, ASubText: string): Boolean;'
      'function StartsStr(const ASubText, AText: string): Boolean;'
      'function EndsStr(const ASubText, AText: string): Boolean;'
      
        'function DupeString(const AText: string; ACount: Integer): strin' +
        'g;'
      'function ReverseString(const AText: string): string;'
      'function SplitString(const S, Delimiters: string): TStringArray;'
      ''
      '// DateUtils'
      'function Now: TDateTime; '
      'function Date: TDateTime;'
      'function Time: TDateTime; '
      'function DayOfWeek(ADate: TDateTime): Integer; '
      'function DayOfTheWeek(ADate: TDateTime): Integer;'
      'function DayOf(ADate: TDateTime): Word;'
      'function MonthOf(ADate: TDateTime): Word;'
      'function YearOf(ADate: TDateTime): Word;'
      'function HourOf(ATime: TDateTime): Word;'
      'function MinuteOf(ATime: TDateTime): Word;'
      'function SecondOf(ATime: TDateTime): Word;'
      'function MilliSecondOf(ATime: TDateTime): Word;'
      
        'function IncDay(const AValue: TDateTime; const ANumberOfDays: In' +
        'teger = 1): TDateTime;'
      
        'function IncMonth(const AValue: TDateTime; const ANumberOfMonths' +
        ': Integer = 1): TDateTime;'
      
        'function IncYear(const AValue: TDateTime; const ANumberOfYears: ' +
        'Integer = 1): TDateTime;'
      'function DaysBetween(const ANow, AThen: TDateTime): Integer;'
      'function HoursBetween(const ANow, AThen: TDateTime): Int64;'
      'function MinutesBetween(const ANow, AThen: TDateTime): Int64;'
      'function SecondsBetween(const ANow, AThen: TDateTime): Int64;'
      ''
      '// SysUtils'
      
        'function FormatDateTime(const Fmt: string; DateTime: TDateTime):' +
        ' string;'
      'function StrToDate(const S: string): TDateTime;'
      'function StrToTime(const S: string): TDateTime;'
      'function StrToDateTime(const S: string): TDateTime;'
      'function DateToStr(Date: TDateTime): string;'
      'function TimeToStr(Time: TDateTime): string;'
      'function DateTimeToStr(DateTime: TDateTime): string;  '
      ''
      ''
      '// SysUtils'
      'function FileExists(const FileName: string): Boolean;'
      'function DirectoryExists(const Directory: string): Boolean;'
      'function CreateDir(const Dir: string): Boolean;'
      'function RemoveDir(const Dir: string): Boolean;'
      'function ForceDirectories(Dir: string): Boolean;'
      'function DeleteFile(const FileName: string): Boolean;'
      'function RenameFile(const OldName, NewName: string): Boolean;'
      
        'function CopyFile(const Source, Dest: string; FailIfExists: Bool' +
